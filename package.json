{
  "name": "qtttweb",
  "version": "1.0.0",
  "description": "QuantumGame",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "start:staging": "node --env-file=.env.staging server/index.js",
    "start:production": "node --env-file=.env.production server/index.js",
    "dev": "node scripts/dev.js",
    "dev:server": "nodemon server/index.js",
    "client:dev": "vite --config vite.config.js",
    "client:build": "vite build --config vite.config.js",
    "client:preview": "vite preview --config vite.config.js",
    "db:init": "node server/persistence/initDb.js",
    "db:init:staging": "node --env-file=.env.staging server/persistence/initDb.js",
    "db:init:production": "node --env-file=.env.production server/persistence/initDb.js",
    "db:expire": "node server/persistence/runExpiryJob.js",
    "db:expire:staging": "node --env-file=.env.staging server/persistence/runExpiryJob.js",
    "db:expire:production": "node --env-file=.env.production server/persistence/runExpiryJob.js",
    "check:project": "node scripts/check-project-health.js",
    "verify": "npm run check:project && npm test && npm run client:build",
    "verify:full": "npm run verify && npm run test:e2e",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "pretest:e2e": "npm run client:build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "author": "ChrisA",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.8.1",
    "ejs": "^3.1.8",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "leo-profanity": "^1.9.0",
    "morgan": "^1.10.1",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-react": "^5.1.0",
    "nodemon": "^2.0.20",
    "vite": "^7.1.12"
  }
}
